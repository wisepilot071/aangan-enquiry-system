# Aangan Studio enquiry system — environment template.
# Copy to .env (never commit .env). Only variables the code actually reads are listed.

# development | test | production
NODE_ENV=development

# Public base URL of this app. Used for the (login-protected) link inside Telegram messages. Optional.
APP_BASE_URL=

# PostgreSQL connection string, e.g. postgres://user:password@host:5432/aangan
# Supabase: use the pooler host; port 6543 (transaction mode) for Vercel/serverless, 5432 for migrations, and add
# ?sslmode=no-verify (or supply the Supabase CA and use sslmode=verify-full). PG_POOL_MAX (default 3) caps connections per instance.
# If empty (development/demo only) an embedded PGlite database is created in ./data. REQUIRED in production.
DATABASE_URL=

# Embedded-database folder when DATABASE_URL is empty (default ./data/pglite). Used by the end-to-end tests.
PGLITE_DATA_DIR=

# Access control. "login" (default) = email + password. "open" = NO sign-in: anyone with the URL gets OPEN_ACCESS_ROLE.
# Open mode exposes caller names and phone numbers to anyone who has the link — use only deliberately.
AUTH_MODE=login
# Role for everyone in open mode: viewer (read-only, default) | operator (transcripts, place calls) | admin (also cost rates).
OPEN_ACCESS_ROLE=viewer

# Signs login sessions. 32+ random characters (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
# REQUIRED in production.
SESSION_SECRET=

# First admin, created by `npm run db:seed`. Generate the hash with: npm run admin:hash -- '<password of 12+ chars>'
# In development, if left empty, a random password is generated and printed once.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Voice provider: "mock" (default; simulated calls, no credentials) or "vaani".
VOICE_PROVIDER=mock

# --- Vaani (https://docs.vaanivoice.ai) — needed when VOICE_PROVIDER=vaani -------------------------------
# API key from the Vaani dashboard (sent as the X-API-Key header). NEVER commit it; rotate it if it is ever shared.
VAANI_API_KEY=
# Agent created by `npm run vaani:setup` (it prints the id and writes it to .env).
VAANI_AGENT_ID=
# Secret that authenticates incoming webhooks (Vaani documents no signature). 24+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Register the webhook in Vaani (Settings -> Webhooks) as:  https://<your-app>/api/webhooks/voice?token=<this value>
VAANI_WEBHOOK_TOKEN=
# Optional override of the API base URL (default https://api.vaanivoice.ai).
VAANI_API_BASE=

# Mock provider only: shared secret (16+ chars) for HMAC-signed mock webhooks. This is OUR mock's scheme, not Vaani's.
MOCK_WEBHOOK_SECRET=

# Telegram designer handoff (create a bot with @BotFather, add it to the designers' chat).
# Both are required for real messages; without them handoffs are recorded as "unavailable".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Calendar: after a QUALIFIED call the app places a TENTATIVE consultation on this calendar and tells the designer on Telegram.
# Create a service account (Google Cloud → IAM → Service accounts → Keys → JSON), enable the Google Calendar API,
# then share the studio calendar with the service account's email ("Make changes to events").
# GOOGLE_SERVICE_ACCOUNT_JSON may be the raw JSON or its base64. Without both values, no event is created.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# debug | info | warn | error
LOG_LEVEL=info
